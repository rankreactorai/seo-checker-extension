{
  "manifest_version": 3,
  "name": "RankReactorAI: AI SEO Checker for Shopify & small sites",
  "short_name": "RankReactorAI SEO",
  "description": "Free one-click SEO check for any page. Shopify-aware tips and an AI-answer readiness score, each with a clear fix.",
  "version": "0.0.0",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Check this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "homepage_url": "https://rankreactor.ai/?utm_source=chrome-extension&utm_medium=extension&utm_campaign=seo-checker&utm_content=homepage_url"
}
